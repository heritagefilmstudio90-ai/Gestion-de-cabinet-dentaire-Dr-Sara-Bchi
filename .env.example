# APP_URL : URL publique où le serveur du cabinet est hébergé (liens externes, CORS natif et OAuth).
APP_URL="MY_APP_URL"

# Passerelle SMS réelle — Twilio SMS ou Webhook HTTP (configurez vos clés dans Secrets / variables serveur)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="MY_TWILIO_AUTH_TOKEN"
# TWILIO_FROM_NUMBER="+212XXXXXXXXX"
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SMS_WEBHOOK_URL="https://votre-passerelle-sms.example.com/send"
# SMS_WEBHOOK_TOKEN="MY_SMS_WEBHOOK_BEARER_TOKEN"

# Passerelle WhatsApp Business Cloud API (Meta) ou Webhook (configurez vos clés dans Secrets / variables serveur)
# WHATSAPP_BUSINESS_TOKEN="EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_GRAPH_VERSION="v21.0"
# WHATSAPP_TEMPLATE_NAME=""
# WHATSAPP_TEMPLATE_LANG="fr"
# WHATSAPP_TEMPLATE_NO_PARAMS="false"
# WHATSAPP_WEBHOOK_VERIFY_TOKEN="MY_META_WEBHOOK_VERIFY_TOKEN"
# WHATSAPP_WEBHOOK_URL="https://votre-passerelle-whatsapp.example.com/send"
# WHATSAPP_WEBHOOK_TOKEN="MY_WHATSAPP_WEBHOOK_BEARER_TOKEN"

# Optionnel (Applications natives Tauri & Capacitor) : URL publique du serveur backend (/api/health, /api/sms/send, /api/whatsapp/send)
# VITE_API_BASE_URL="https://ais-pre-tsq472ukkgzhv2xqsfuqx5-1005453407597.europe-west2.run.app"
