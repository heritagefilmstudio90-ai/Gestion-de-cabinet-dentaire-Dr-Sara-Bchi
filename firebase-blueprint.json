        "sku": { "type": "string", "minLength": 1, "maxLength": 40 },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "category": { "type": "string", "enum": ["Consommables", "Désinfection", "Résines & Composites", "Ciments", "Anesthésie", "Implants & Chirurgie", "Autre"] },
        "unit": { "type": "string", "maxLength": 30 },
        "quantity": { "type": "number" },
        "minThreshold": { "type": "number" },
        "unitCost": { "type": "number" },
        "supplier": { "type": "string", "maxLength": 120 },
        "expiryDate": { "type": "string", "maxLength": 20 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sku", "name", "category", "unit", "quantity", "minThreshold", "unitCost", "updatedAt"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Mouvement d'entrée ou de sortie de stock traçable.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "type": { "type": "string", "enum": ["Entrée", "Sortie"] },
        "quantity": { "type": "number" },
        "reason": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 20 },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "itemName", "type", "quantity", "date", "createdBy", "createdAt"]
    },
    "AdminDocument": {
      "title": "AdminDocument",
      "description": "Licence logicielle, contrat d'entretien de matériel dentaire ou document administratif soumis à renouvellement.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "enum": ["Licence logicielle", "Contrat d'entretien", "Assurance & Conformité", "Autre"] },
        "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reference": { "type": "string", "maxLength": 80 },
        "expiryDate": { "type": "string", "maxLength": 20 },
        "alertDaysBefore": { "type": "number" },
        "status": { "type": "string", "enum": ["Actif", "À renouveler", "Renouvelé"] },
        "notes": { "type": "string", "maxLength": 300 },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "provider", "expiryDate", "alertDaysBefore", "status", "createdBy", "createdAt", "updatedAt"]
    }
  },
