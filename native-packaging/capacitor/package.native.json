{
  "name": "dentaflow-pro-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Empaquetage mobile natif Capacitor (Android & iOS) pour Gestion de cabinet dentaire Dr. Sara Bchi",
  "scripts": {
    "build:web": "npm --prefix ../.. run build",
    "cap:assets": "node ../scripts/prepare-icons.mjs && npx @capacitor/assets generate --iconBackgroundColor '#0B2239' --splashBackgroundColor '#0B2239' --splashBackgroundColorDark '#0B2239'",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build:web && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/network": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.7.0"
  }
}
